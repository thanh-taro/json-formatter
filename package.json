{
  "name": "json-formatter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private, lossless JSON formatter for developers, embedded in the taro-kit tools portal.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen": "node scripts/gen-all.mjs",
    "gen:check": "node scripts/gen-all.mjs --check",
    "dev": "pnpm gen && vite",
    "build": "pnpm gen && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=chromium",
    "fixtures:jsontestsuite": "node scripts/fetch-jsontestsuite.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:size": "node scripts/check-size.mjs",
    "lhci": "lhci autorun",
    "spec:lint": "python3 tools/spec_lint.py",
    "bench": "vitest run --config tests/bench/vitest.config.ts",
    "smoke:prod": "node scripts/smoke-prod.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@preact/signals": "2.11.2",
    "lucide-static": "1.55.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "eslint": "10.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "style-dictionary": "5.5.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.149.0"
  }
}
