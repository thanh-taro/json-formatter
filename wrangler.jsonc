// Cloudflare Workers static assets, assets only, no Worker script (ADR-0009, MOD-Build).
// Deployed by hand only (locally, `pnpm exec wrangler deploy`; there are no CI workflows); nothing here is a secret.
// The account comes from the CLOUDFLARE_ACCOUNT_ID environment variable, never from this file.
// Headers: dist/_headers (generated by `pnpm gen`, including the /sw.js exception).
// Not uploaded: dist/.assetsignore (from public/.assetsignore) lists *.map and .vite.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "json-formatter",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths answer a plain 404 (a single-page tool with no client routes).
    "not_found_handling": "none",
  },
  // Only the custom domain serves the tool: no *.workers.dev address, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "json-formatter.tarokit.app", "custom_domain": true }],
}
